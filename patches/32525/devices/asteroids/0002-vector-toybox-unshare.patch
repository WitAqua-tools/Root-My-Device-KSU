+/// Run a normal lifecycle stage while reserving one module for a monitored
+/// device-specific launcher. Common scripts and the metamodule still run.
+pub fn run_stage_excluding_module(stage: &str, block: bool, excluded_module_id: &str) {
+    utils::umask(0);
+
+    if utils::has_magisk() {
+        warn!("Magisk detected, skip {stage}");
+        return;
+    }
+
+    if crate::utils::is_safe_mode() {
+        warn!("safe mode, skip {stage} scripts");
+        return;
+    }
+
+    if let Err(e) = crate::module::exec_common_scripts(&format!("{stage}.d"), block) {
+        warn!("Failed to exec common {stage} scripts: {e}");
+    }
+
+    if let Err(e) = metamodule::exec_stage_script(stage, block) {
+        warn!("Failed to exec metamodule {stage} script: {e}");
+    }
+
+    if let Err(e) = crate::module::exec_stage_script_excluding(stage, block, excluded_module_id) {
+        warn!("Failed to exec {stage} scripts excluding module {excluded_module_id}: {e}");
+    }
+}
