+/// Execute a lifecycle stage for every active regular module except one that
+/// the caller will launch and monitor itself.
+pub fn exec_stage_script_excluding(
+    stage: &str,
+    block: bool,
+    excluded_module_id: &str,
+) -> Result<()> {
+    let metamodule_dir = metamodule::get_metamodule_path().and_then(|path| canonicalize(path).ok());
+
+    foreach_active_module(|module| {
+        if metamodule_dir.as_ref().is_some_and(|meta_dir| {
+            canonicalize(module).is_ok_and(|resolved| resolved == *meta_dir)
+        }) {
+            return Ok(());
+        }
+
+        if module.file_name().and_then(|name| name.to_str()) == Some(excluded_module_id) {
+            info!("Skipping {stage}.sh for monitored module {excluded_module_id}");
+            return Ok(());
+        }
+
+        let script_path = module.join(format!("{stage}.sh"));
+        if !script_path.exists() {
+            return Ok(());
+        }
+
+        exec_script(&script_path, block)
+    })?;
+
+    Ok(())
+}
