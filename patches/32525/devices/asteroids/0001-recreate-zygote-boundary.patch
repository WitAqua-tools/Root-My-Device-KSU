+fn process_id(name: &str) -> Option<String> {
+    let output = Command::new("/system/bin/pidof").arg(name).output().ok()?;
+    if !output.status.success() {
+        return None;
+    }
+    let value = String::from_utf8_lossy(&output.stdout).trim().to_string();
+    (!value.is_empty()).then_some(value)
+}
+
+fn restart_zygote_for_late_modules() -> Result<()> {
+    let old_system_server = process_id("system_server");
+    info!(
+        "Asteroids late-load: recreating zygote-start boundary (old system_server={old_system_server:?})"
+    );
+
+    let status = Command::new("/system/bin/setprop")
+        .args(["ctl.restart", "zygote"])
+        .status()
+        .context("failed to request zygote restart")?;
+    anyhow::ensure!(status.success(), "zygote restart request exited {status}");
+
+    // A successful ctl.restart request only means init accepted it. Wait until
+    // the replacement zygote has produced a replacement system_server so the
+    // service stage cannot race the soft framework restart.
+    for _ in 0..80 {
+        let zygote_running = utils::getprop("init.svc.zygote").as_deref() == Some("running");
+        let new_system_server = process_id("system_server");
+        let system_server_replaced = new_system_server.is_some()
+            && (old_system_server.is_none() || new_system_server != old_system_server);
+        if zygote_running && system_server_replaced {
+            info!(
+                "Asteroids late-load: zygote/system_server restarted (system_server={new_system_server:?})"
+            );
+            thread::sleep(Duration::from_millis(500));
+            return Ok(());
+        }
+        thread::sleep(Duration::from_millis(250));
+    }
+
+    anyhow::bail!("zygote restart did not produce a replacement system_server within 20 seconds")
+}
+
+fn write_module_completion_marker() -> Result<()> {
+    const BOOT_ID: &str = "/proc/sys/kernel/random/boot_id";
+    const MARKER: &str = "/data/local/tmp/.ksu-late-load-modules-ok";
+    const TEMP: &str = "/data/local/tmp/.ksu-late-load-modules-ok.tmp";
+
+    let boot_id =
+        fs::read_to_string(BOOT_ID).context("failed to read boot_id for module marker")?;
+    fs::write(TEMP, boot_id.as_bytes()).context("failed to write temporary module marker")?;
+    fs::set_permissions(TEMP, fs::Permissions::from_mode(0o644))
+        .context("failed to chmod module marker")?;
+    fs::rename(TEMP, MARKER).context("failed to publish module marker")?;
+    info!("Asteroids late-load: module completion marker published");
+    Ok(())
+}
