+fn verify_installed_daemon_exact(
+    authorities: &mut CleanupAuthorities,
+    expected_daemon_sha256: &str,
+) -> Result<()> {
+    validate_root_data_directory(&authorities.installed_parent, "installed daemon parent")?;
+    let metadata = authorities
+        .installed_daemon
+        .metadata()
+        .context("failed to fstat retained installed daemon")?;
+    anyhow::ensure!(
+        metadata.file_type().is_file()
+            && metadata.uid() == 0
+            && metadata.gid() == 0
+            && metadata.mode() & 0o777 == 0o755
+            && metadata.nlink() == 1
+            && metadata.dev() == authorities.installed_device
+            && metadata.ino() == authorities.installed_inode
+            && metadata.len() == authorities.installed_size,
+        "installed /data/adb/ksud metadata/inode is not exact root:root 0755 nlink=1"
+    );
+    let path = fstatat_raw(
+        &authorities.installed_parent,
+        "ksud",
+        "installed daemon pathname",
+    )?;
+    anyhow::ensure!(
+        path.st_dev as u64 == authorities.installed_device
+            && path.st_ino as u64 == authorities.installed_inode
+            && u64::from(path.st_nlink) == 1
+            && path.st_uid == 0
+            && path.st_gid == 0
+            && (path.st_mode as u32 & 0o777) == 0o755
+            && path.st_size as u64 == authorities.installed_size,
+        "installed daemon pathname no longer names the retained inode"
+    );
+    let first = digest_exact_file(
+        &mut authorities.installed_daemon,
+        authorities.installed_size,
+        "installed daemon",
+    )?;
+    let second = digest_exact_file(
+        &mut authorities.private_exec,
+        authorities.installed_size,
+        "unlinked private executable inode",
+    )?;
+    anyhow::ensure!(
+        first == expected_daemon_sha256 && second == expected_daemon_sha256,
+        "installed daemon SHA-256 failed exact post-cleanup verification"
+    );
+    Ok(())
+}
