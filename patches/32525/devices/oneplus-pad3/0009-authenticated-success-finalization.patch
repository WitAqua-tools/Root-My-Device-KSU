+fn verify_receipt_exact(
+    directory: &File,
+    name: &str,
+    expected: &[u8],
+    mode: u32,
+    label: &str,
+) -> Result<()> {
+    let mut receipt = openat_readonly(directory, name, label)?;
+    let metadata = receipt
+        .metadata()
+        .with_context(|| format!("failed to fstat retained {label}"))?;
+    anyhow::ensure!(
+        metadata.file_type().is_file()
+            && metadata.uid() == 0
+            && metadata.gid() == 0
+            && metadata.mode() & 0o777 == mode
+            && metadata.nlink() == 1
+            && metadata.len() == expected.len() as u64,
+        "retained {label} metadata is not exact"
+    );
+    let content = read_exact_file(&mut receipt, expected.len(), label)?;
+    anyhow::ensure!(content == expected, "retained {label} content is not exact");
+    let path = fstatat_raw(directory, name, label)?;
+    anyhow::ensure!(
+        path.st_dev as u64 == metadata.dev()
+            && path.st_ino as u64 == metadata.ino()
+            && u64::from(path.st_nlink) == 1
+            && path.st_uid == 0
+            && path.st_gid == 0
+            && (path.st_mode as u32 & 0o777) == mode
+            && path.st_size as u64 == expected.len() as u64,
+        "retained {label} pathname identity changed"
+    );
+    Ok(())
+}
