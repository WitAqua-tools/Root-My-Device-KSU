+fn validate_root_data_directory(directory: &File, label: &str) -> Result<()> {
+    let metadata = directory
+        .metadata()
+        .with_context(|| format!("failed to fstat retained {label}"))?;
+    anyhow::ensure!(
+        metadata.file_type().is_dir()
+            && metadata.uid() == 0
+            && metadata.gid() == 0
+            && metadata.mode() & 0o022 == 0,
+        "retained {label} is not a protected root:root directory"
+    );
+    Ok(())
+}
+
+fn open_root_data_directory(path: &str, label: &str) -> Result<File> {
+    let directory = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(path)
+        .with_context(|| format!("failed to pin {label} {path}"))?;
+    validate_root_data_directory(&directory, label)?;
+    Ok(directory)
+}
+
+fn openat_readonly(directory: &File, name: &str, label: &str) -> Result<File> {
+    let name = CString::new(name).with_context(|| format!("{label} name contains NUL"))?;
+    let fd = unsafe {
+        libc::openat(
+            directory.as_raw_fd(),
+            name.as_ptr(),
+            libc::O_RDONLY | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+        )
+    };
+    if fd < 0 {
+        return Err(std::io::Error::last_os_error())
+            .with_context(|| format!("failed to open retained {label}"));
+    }
+    Ok(unsafe { File::from_raw_fd(fd) })
+}
+
+fn fstatat_raw(directory: &File, name: &str, label: &str) -> Result<libc::stat> {
+    fstatat_optional(directory, name, label)?.with_context(|| format!("retained {label} is absent"))
+}
+
+fn fstatat_optional(directory: &File, name: &str, label: &str) -> Result<Option<libc::stat>> {
+    let name = CString::new(name).with_context(|| format!("{label} name contains NUL"))?;
+    let mut metadata = std::mem::MaybeUninit::<libc::stat>::uninit();
+    let result = unsafe {
+        libc::fstatat(
+            directory.as_raw_fd(),
+            name.as_ptr(),
+            metadata.as_mut_ptr(),
+            libc::AT_SYMLINK_NOFOLLOW,
+        )
+    };
+    if result != 0 {
+        let error = std::io::Error::last_os_error();
+        if error.kind() == ErrorKind::NotFound {
+            return Ok(None);
+        }
+        return Err(error).with_context(|| format!("failed to stat retained {label}"));
+    }
+    Ok(Some(unsafe { metadata.assume_init() }))
+}
+
+fn prove_name_absent(directory: &File, name: &str, label: &str) -> Result<()> {
+    let name = CString::new(name).with_context(|| format!("{label} name contains NUL"))?;
+    let mut metadata = std::mem::MaybeUninit::<libc::stat>::uninit();
+    let result = unsafe {
+        libc::fstatat(
+            directory.as_raw_fd(),
+            name.as_ptr(),
+            metadata.as_mut_ptr(),
+            libc::AT_SYMLINK_NOFOLLOW,
+        )
+    };
+    if result == 0 {
+        anyhow::bail!("retained {label} name is still present");
+    }
+    let error = std::io::Error::last_os_error();
+    anyhow::ensure!(
+        error.kind() == ErrorKind::NotFound,
+        "retained {label} absence could not be proved: {error}"
+    );
+    Ok(())
+}
+
+fn read_exact_file(file: &mut File, maximum: usize, label: &str) -> Result<Vec<u8>> {
+    file.seek(SeekFrom::Start(0))
+        .with_context(|| format!("failed to seek retained {label}"))?;
+    let mut value = Vec::new();
+    file.take((maximum + 1) as u64)
+        .read_to_end(&mut value)
+        .with_context(|| format!("failed to read retained {label}"))?;
+    anyhow::ensure!(value.len() <= maximum, "retained {label} is too large");
+    Ok(value)
+}
+
+fn digest_exact_file(file: &mut File, expected_size: u64, label: &str) -> Result<String> {
+    let before = file
+        .metadata()
+        .with_context(|| format!("failed to fstat retained {label}"))?;
+    anyhow::ensure!(
+        before.file_type().is_file() && before.len() == expected_size,
+        "retained {label} has the wrong type or size"
+    );
+    let bytes = read_exact_file(
+        file,
+        usize::try_from(expected_size).context("retained daemon size overflow")?,
+        label,
+    )?;
+    anyhow::ensure!(
+        bytes.len() as u64 == expected_size,
+        "retained {label} changed size while hashing"
+    );
+    let after = file
+        .metadata()
+        .with_context(|| format!("failed to refstat retained {label}"))?;
+    anyhow::ensure!(
+        before.dev() == after.dev()
+            && before.ino() == after.ino()
+            && before.len() == after.len()
+            && before.uid() == after.uid()
+            && before.gid() == after.gid()
+            && before.mode() == after.mode()
+            && before.nlink() == after.nlink(),
+        "retained {label} metadata changed while hashing"
+    );
+    Ok(sha256::digest(bytes.as_slice()))
+}
