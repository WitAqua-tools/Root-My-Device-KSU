+pub fn run(
+    package_name: &String,
+    kmi: Option<String>,
+    allow_shell: bool,
+    modules: bool,
+) -> Result<()> {
+    let mut cleanup_expectation = None;
+    match run_inner(
+        package_name,
+        kmi,
+        allow_shell,
+        modules,
+        &mut cleanup_expectation,
+    ) {
+        Ok(()) => Ok(()),
+        Err(operation_error) => {
+            let Some(mut expectation) = cleanup_expectation else {
+                return Err(operation_error);
+            };
+            match cleanup_post_load_failure(&mut expectation) {
+                Ok(()) => {
+                    error!(
+                        "OnePlus Pad 3 late-load failed after KernelSU load; exact retained-fd ksu-domain rollback completed: {operation_error:#}"
+                    );
+                    // C authenticates this reserved value with waitpid() of
+                    // the direct inode/hash-pinned loader child and the empty
+                    // exec-error pipe. Panic=abort and signals never reach
+                    // this branch and therefore cannot forge cleanup proof.
+                    std::process::exit(CLEAN_ABORT_EXIT_STATUS);
+                }
+                Err(cleanup_error) => {
+                    error!(
+                        "OnePlus Pad 3 post-load cleanup incomplete; C watcher must remain fail-stop: {cleanup_error:#}"
+                    );
+                    Err(operation_error).context(format!(
+                        "post-load cleanup proof was not emitted: {cleanup_error:#}"
+                    ))
+                }
+            }
+        }
+    }
+}

