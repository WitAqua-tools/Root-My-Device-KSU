+#[cfg(unix)]
+fn validate_staged_metadata(
+    metadata: &std::fs::Metadata,
+    expected_mode: u32,
+    label: &str,
+) -> Result<()> {
+    anyhow::ensure!(
+        metadata.file_type().is_file(),
+        "{label} is not a regular file"
+    );
+    anyhow::ensure!(
+        metadata.uid() == 0 && metadata.gid() == 0,
+        "{label} is not root:root"
+    );
+    let mode = metadata.mode() & 0o777;
+    anyhow::ensure!(
+        mode == expected_mode,
+        "{label} mode is {mode:o}, expected {expected_mode:o}"
+    );
+    anyhow::ensure!(
+        metadata.len() > 0 && metadata.len() <= MAX_STAGED_DAEMON_SIZE,
+        "{label} size {} is outside 1..={MAX_STAGED_DAEMON_SIZE}",
+        metadata.len()
+    );
+    Ok(())
+}
+
+#[cfg(unix)]
+fn digest_open_daemon(
+    file: &mut File,
+    metadata: &std::fs::Metadata,
+    label: &str,
+) -> Result<String> {
+    let capacity = usize::try_from(metadata.len()).context("staged daemon size overflow")?;
+    let mut bytes = Vec::with_capacity(capacity);
+    file.read_to_end(&mut bytes)
+        .with_context(|| format!("Failed to read {label}"))?;
+    anyhow::ensure!(
+        bytes.len() as u64 == metadata.len(),
+        "{label} changed size while hashing"
+    );
+    Ok(sha256::digest(bytes.as_slice()))
+}
