+/// Strict stage dispatcher for late-load completion contracts.
+///
+/// Non-blocking stages still spawn their scripts and return immediately, but
+/// every common, metamodule, and regular-module dispatch error is propagated
+/// to the caller instead of being reduced to a warning.
+pub fn run_stage_checked(stage: &str, block: bool) -> Result<()> {
+    run_stage_except_module_checked(stage, block, None)
+}
+
+pub fn run_stage_except_module_checked(
+    stage: &str,
+    block: bool,
+    excluded_module: Option<&str>,
+) -> Result<()> {
+    utils::umask(0);
+
+    anyhow::ensure!(
+        !utils::has_magisk(),
+        "Magisk detected, refusing checked {stage} stage"
+    );
+    anyhow::ensure!(
+        !crate::utils::is_safe_mode(),
+        "safe mode active, refusing checked {stage} stage"
+    );
+
+    crate::module::exec_common_scripts(&format!("{stage}.d"), block)
+        .with_context(|| format!("failed to dispatch common {stage} scripts"))?;
+    metamodule::exec_stage_script(stage, block)
+        .with_context(|| format!("failed to dispatch metamodule {stage} script"))?;
+    crate::module::exec_stage_script_except(stage, block, excluded_module)
+        .with_context(|| format!("failed to dispatch module {stage} scripts"))?;
+    Ok(())
+}
+
