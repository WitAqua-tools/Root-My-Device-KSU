+fn public_log_name(path: &str, label: &str) -> Result<String> {
+    let path = Path::new(path);
+    anyhow::ensure!(
+        path.parent() == Some(Path::new("/data/local/tmp")),
+        "{label} is outside /data/local/tmp"
+    );
+    let name = path
+        .file_name()
+        .and_then(|value| value.to_str())
+        .with_context(|| format!("{label} has no UTF-8 filename"))?;
+    anyhow::ensure!(
+        !name.is_empty()
+            && name
+                .bytes()
+                .all(|byte| { byte.is_ascii_alphanumeric() || matches!(byte, b'.' | b'_' | b'-') }),
+        "{label} filename is not a safe fixed name"
+    );
+    Ok(name.to_owned())
+}
+
+/// Create a public diagnostic log without following a shell-controlled path.
+///
+/// `/data/local/tmp` belongs to shell, so `File::create(path)` would permit a
+/// pre-existing symlink to redirect a root write. Create and authenticate a
+/// root-owned inode through a retained directory FD, atomically publish it,
+/// and keep writing through that pinned FD even if shell later unlinks it.
+fn create_public_log_exact(path: &str, label: &str) -> Result<File> {
+    let name = public_log_name(path, label)?;
+    let directory = open_cleanup_directory("/data/local/tmp", false)?;
+    let final_name = CString::new(name.as_str()).context("public log name contains NUL")?;
+
+    for attempt in 0..32u32 {
+        let temporary_name = format!(".{name}.{}.{}.tmp", std::process::id(), attempt);
+        let temporary_c = CString::new(temporary_name.as_str())
+            .context("public log temporary name contains NUL")?;
+        let fd = unsafe {
+            libc::openat(
+                directory.as_raw_fd(),
+                temporary_c.as_ptr(),
+                libc::O_RDWR | libc::O_CREAT | libc::O_EXCL | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+                0o600,
+            )
+        };
+        if fd < 0 {
+            let error = std::io::Error::last_os_error();
+            if error.kind() == ErrorKind::AlreadyExists {
+                continue;
+            }
+            return Err(error).with_context(|| {
+                format!("failed to create secure public log temporary file for {label}")
+            });
+        }
+        let file = unsafe { File::from_raw_fd(fd) };
+        let result = (|| -> Result<()> {
+            if unsafe { libc::fchown(file.as_raw_fd(), 0, 0) } != 0
+                || unsafe { libc::fchmod(file.as_raw_fd(), 0o644) } != 0
+            {
+                return Err(std::io::Error::last_os_error())
+                    .with_context(|| format!("failed to secure {label} inode"));
+            }
+            let metadata = file
+                .metadata()
+                .with_context(|| format!("failed to fstat {label} inode"))?;
+            anyhow::ensure!(
+                metadata.file_type().is_file()
+                    && metadata.uid() == 0
+                    && metadata.gid() == 0
+                    && metadata.mode() & 0o777 == 0o644
+                    && metadata.nlink() == 1
+                    && metadata.len() == 0,
+                "{label} temporary inode metadata is not exact"
+            );
+            let temporary_path =
+                fstatat_raw(&directory, &temporary_name, "public log temporary pathname")?;
+            anyhow::ensure!(
+                temporary_path.st_dev as u64 == metadata.dev()
+                    && temporary_path.st_ino as u64 == metadata.ino(),
+                "{label} temporary pathname was replaced"
+            );
+            if unsafe {
+                libc::renameat(
+                    directory.as_raw_fd(),
+                    temporary_c.as_ptr(),
+                    directory.as_raw_fd(),
+                    final_name.as_ptr(),
+                )
+            } != 0
+            {
+                return Err(std::io::Error::last_os_error())
+                    .with_context(|| format!("failed to atomically publish {label}"));
+            }
+            directory
+                .sync_all()
+                .with_context(|| format!("failed to sync {label} parent directory"))?;
+            let published = fstatat_raw(&directory, &name, "public log pathname")?;
+            anyhow::ensure!(
+                published.st_dev as u64 == metadata.dev()
+                    && published.st_ino as u64 == metadata.ino()
+                    && published.st_uid == 0
+                    && published.st_gid == 0
+                    && (published.st_mode as u32 & 0o777) == 0o644
+                    && u64::from(published.st_nlink) == 1,
+                "{label} published pathname is not the authenticated inode"
+            );
+            Ok(())
+        })();
+        if result.is_err()
+            && let Ok(Some(path_metadata)) = fstatat_optional(
+                &directory,
+                &temporary_name,
+                "failed public log temporary pathname",
+            )
+            && let Ok(metadata) = file.metadata()
+            && path_metadata.st_dev as u64 == metadata.dev()
+            && path_metadata.st_ino as u64 == metadata.ino()
+        {
+            let _ = unsafe { libc::unlinkat(directory.as_raw_fd(), temporary_c.as_ptr(), 0) };
+            let _ = directory.sync_all();
+        }
+        result?;
+        return Ok(file);
+    }
+
+    anyhow::bail!("could not allocate a unique secure public log inode for {label}")
+}
