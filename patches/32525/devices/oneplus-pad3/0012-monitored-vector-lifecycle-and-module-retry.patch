+        if owned != 0 || chmod != 0 {
+            return Err(std::io::Error::last_os_error())
+                .context("failed to secure private receipt temporary file");
+        }
+        temporary
+            .write_all(content)
+            .context("failed to write private receipt temporary file")?;
+        temporary
+            .sync_all()
+            .context("failed to sync private receipt temporary file")?;
+        let metadata = temporary
+            .metadata()
+            .context("failed to fstat private receipt temporary file")?;
+        anyhow::ensure!(
+            metadata.file_type().is_file()
+                && metadata.uid() == 0
+                && metadata.gid() == 0
+                && metadata.mode() & 0o777 == 0o600
+                && metadata.nlink() == 1
+                && metadata.len() == content.len() as u64,
+            "private receipt temporary metadata is not exact"
+        );
+        let path = fstatat_raw(
+            private_receipts,
+            &temp_name,
+            "private receipt temporary pathname",
+        )?;
+        anyhow::ensure!(
+            path.st_dev as u64 == metadata.dev() && path.st_ino as u64 == metadata.ino(),
+            "private receipt temporary pathname was replaced"
+        );
+        let renamed = unsafe {
+            libc::renameat(
+                private_receipts.as_raw_fd(),
+                temp_c.as_ptr(),
+                private_receipts.as_raw_fd(),
+                final_c.as_ptr(),
+            )
+        };
+        if renamed != 0 {
+            return Err(std::io::Error::last_os_error())
+                .context("failed to atomically publish private receipt");
+        }
+        private_receipts
+            .sync_all()
+            .context("failed to sync private receipt directory")?;
+        verify_receipt_exact(
+            private_receipts,
+            "modules-loaded",
+            content,
+            0o600,
+            "module-retry private completion receipt",
+        )
+    })();
+    if result.is_err()
+        && let Ok(path) = fstatat_raw(
+            private_receipts,
+            &temp_name,
+            "failed private receipt temporary pathname",
+        )
+        && let Ok(metadata) = temporary.metadata()
+        && path.st_dev == metadata.dev()
+        && path.st_ino == metadata.ino()
+    {
+        let _ = unsafe { libc::unlinkat(private_receipts.as_raw_fd(), temp_c.as_ptr(), 0) };
+        let _ = private_receipts.sync_all();
+    }
+    result
+}
+
+fn module_retry_receipt(run_id: &str, ksud_sha256: &str) -> Result<Vec<u8>> {
+    validate_lower_hex(run_id, 32, "module retry run id")?;
+    validate_lower_hex(ksud_sha256, 64, "module retry ksud SHA-256")?;
+    let boot_id = current_boot_id()?;
+    Ok(
+        format!("version=1\nboot_id={boot_id}\nrun_id={run_id}\nksud_sha256={ksud_sha256}\n")
+            .into_bytes(),
     )
 }
 
+fn module_retry_package_valid(package_name: &str) -> bool {
+    !package_name.is_empty()
+        && package_name
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'.' | b'_'))
+}
+
+pub fn retry_modules(package_name: &str, run_id: &str, expected_ksud_sha256: &str) -> Result<()> {
+    validate_lower_hex(run_id, 32, "module retry run id")?;
+    validate_lower_hex(
+        expected_ksud_sha256,
+        64,
+        "expected module retry ksud SHA-256",
+    )?;
+    anyhow::ensure!(
+        module_retry_package_valid(package_name),
+        "module retry Manager package name is invalid"
+    );
+    require_exact_ksu_selinux_context()
+        .context("module retry did not start in the exact KernelSU SELinux domain")?;
+    anyhow::ensure!(
+        unsafe { libc::geteuid() } == 0 && unsafe { libc::getegid() } == 0,
+        "module retry executor is not root:root"
+    );
+    let enforcing = fs::read(SELINUX_ENFORCE_PATH)
+        .context("failed to read SELinux state before module retry")?;
+    anyhow::ensure!(
+        enforcing.as_slice() == b"1" || enforcing.as_slice() == b"1\n",
+        "module retry requires SELinux enforcing=1"
+    );
+    anyhow::ensure!(
+        !utils::has_magisk(),
+        "module retry was requested while Magisk is active"
+    );
+    anyhow::ensure!(
+        !utils::is_safe_mode(),
+        "module retry was requested while KernelSU safe mode is active"
+    );
+    verify_fresh_ksu_control().context("module retry KernelSU control preflight failed")?;
+
+    // The command is launched through `su -M`, but independently rejoin init's
+    // mount namespace so all OverlayFS mounts and module daemons outlive this
+    // process and are visible to zygote/system_server.
+    utils::switch_mnt_ns(1).context("failed to rejoin init mount namespace for module retry")?;
+    utils::reset_std().context("failed to reset stdio after joining init mount namespace")?;
+    utils::umask(0);
+    ensure_private_receipt_directory()?;
+
+    let mut daemon = RetryDaemonAuthority::pin(expected_ksud_sha256)?;
+    let private_receipts = open_cleanup_directory(PRIVATE_LATE_LOAD_ROOT, true)?;
+    let public_receipts = open_cleanup_directory("/data/local/tmp", false)?;
+    unlink_sync_prove_absent(
+        &private_receipts,
+        PRIVATE_LATE_LOAD_ROOT,
+        "modules-loaded",
+        true,
+    )?;
+    unlink_sync_prove_absent(
+        &public_receipts,
+        "/data/local/tmp",
+        ".ksu-late-load-modules-ok",
+        false,
+    )?;
+
+    info!("OnePlus Pad 3 module-retry: authenticated enforcing-state lifecycle started");
+    let operation = (|| -> Result<()> {
+        if let Err(error) = crate::module_config::clear_all_temp_configs() {
+            warn!("module retry clear temp configs failed: {error}");
+        }
+        if let Err(error) = handle_updated_modules() {
+            warn!("module retry handle updated modules failed: {error}");
+        }
+        if let Err(error) = prune_modules() {
+            warn!("module retry prune modules failed: {error}");
+        }
+        if let Err(error) = restorecon::restorecon() {
+            warn!("module retry restorecon failed: {error}");
+        }
+        if let Err(error) = crate::module::load_sepolicy_rule() {
+            warn!("module retry load sepolicy.rule failed: {error}");
+        }
+        if let Err(error) = crate::profile::apply_sepolies() {
+            warn!("module retry apply root profile sepolicy failed: {error}");
+        }
+        if let Err(error) = crate::feature::init_features() {
+            warn!("module retry feature initialization failed: {error}");
+        }
+
+        init_event::run_late_load_compat_stage()
+            .context("module retry late-load compatibility stage failed")?;
+        if let Err(error) = crate::module::load_system_prop() {
+            warn!("module retry load system.prop failed: {error}");
+        }
+        if let Err(error) = metamodule::exec_mount_script(defs::MODULE_DIR) {
+            warn!("module retry metamodule mount failed: {error}");
+        }
+        init_event::run_stage_checked("post-mount", true)
+            .context("module retry post-mount stage failed")?;
+        run_module_service_lifecycle().context("module retry service lifecycle failed")?;
+        init_event::run_stage_to_completion("boot-completed", None, COMPLETION_SCRIPT_TIMEOUT)
+            .context("module retry boot-completed stage failed")?;
+
+        daemon.verify()?;
+        verify_fresh_ksu_control().context("module retry final KernelSU control check failed")?;
+        let enforcing = fs::read(SELINUX_ENFORCE_PATH)
+            .context("failed to read final SELinux state after module retry")?;
+        anyhow::ensure!(
+            enforcing.as_slice() == b"1" || enforcing.as_slice() == b"1\n",
+            "SELinux was not enforcing after module retry"
+        );
+
+        let receipt = module_retry_receipt(run_id, &daemon.sha256)?;
+        publish_private_receipt_exact(&private_receipts, run_id, &receipt)?;
+        publish_public_receipt_exact(&public_receipts, run_id, &receipt)?;
+        verify_receipt_exact(
+            &private_receipts,
+            "modules-loaded",
+            &receipt,
+            0o600,
+            "module-retry private completion receipt",
+        )?;
+        verify_receipt_exact(
+            &public_receipts,
+            ".ksu-late-load-modules-ok",
+            &receipt,
+            0o644,
+            "module-retry public completion receipt",
+        )?;
+        daemon.verify()?;
+        verify_fresh_ksu_control().context("module retry post-receipt control check failed")?;
+        Ok(())
+    })();
+
+    if let Err(error) = operation {
+        let private_cleanup = unlink_sync_prove_absent(
+            &private_receipts,
+            PRIVATE_LATE_LOAD_ROOT,
+            "modules-loaded",
+            true,
+        );
+        let public_cleanup = unlink_sync_prove_absent(
+            &public_receipts,
+            "/data/local/tmp",
+            ".ksu-late-load-modules-ok",
+            false,
+        );
+        if let (Err(private_error), Err(public_error)) = (&private_cleanup, &public_cleanup) {
+            anyhow::bail!(
+                "module retry failed: {error:#}; both receipt cleanups failed: private={private_error:#}; public={public_error:#}"
+            );
+        }
+        if let Err(cleanup_error) = private_cleanup {
+            anyhow::bail!(
+                "module retry failed: {error:#}; private receipt cleanup failed: {cleanup_error:#}"
+            );
+        }
+        if let Err(cleanup_error) = public_cleanup {
+            anyhow::bail!(
+                "module retry failed: {error:#}; public receipt cleanup failed: {cleanup_error:#}"
+            );
+        }
+        return Err(error).context("OnePlus Pad 3 authenticated module retry failed");
+    }
+
+    append_module_lifecycle_log("authenticated module-retry receipt published");
+    restart_manager_after_late_load(package_name);
+    info!("OnePlus Pad 3 module-retry: lifecycle and receipts verified");
+    Ok(())
+}
