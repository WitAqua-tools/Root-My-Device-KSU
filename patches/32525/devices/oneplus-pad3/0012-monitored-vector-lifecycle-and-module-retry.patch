+fn reset_module_lifecycle_log() {
+    let operation = (|| -> Result<()> {
+        let boot_id = current_boot_id().unwrap_or_else(|_| "unknown".to_owned());
+        let mut file = create_public_log_exact(MODULE_LIFECYCLE_LOG, "module lifecycle log")?;
+        writeln!(file, "boot_id={boot_id} pid={}", std::process::id())
+            .context("failed to initialize module lifecycle log")?;
+        file.sync_all()
+            .context("failed to sync initialized module lifecycle log")
+    })();
+    if let Err(error) = operation {
+        warn!("OnePlus Pad 3 late-load: failed to reset module lifecycle log: {error:#}");
+    }
+}
