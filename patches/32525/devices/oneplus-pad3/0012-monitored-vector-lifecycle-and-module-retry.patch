+        );
+        let path = fstatat_raw(
+            &self.installed_parent,
+            "ksud",
+            "retry installed daemon pathname",
+        )?;
+        anyhow::ensure!(
+            path.st_dev as u64 == self.device
+                && path.st_ino as u64 == self.inode
+                && u64::from(path.st_nlink) == 1
+                && path.st_uid == 0
+                && path.st_gid == 0
+                && (path.st_mode as u32 & 0o777) == 0o755
+                && path.st_size as u64 == self.size,
+            "current /data/adb/ksud no longer names the authenticated retry inode"
+        );
+        let digest = digest_exact_file(
+            &mut self.installed_daemon,
