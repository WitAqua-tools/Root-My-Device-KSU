+impl RetryDaemonAuthority {
+    fn pin(expected_sha256: &str) -> Result<Self> {
+        validate_lower_hex(expected_sha256, 64, "expected retry ksud SHA-256")?;
+        let installed_parent = open_root_data_directory("/data/adb", "retry daemon parent")?;
+        let mut installed_daemon =
+            openat_readonly(&installed_parent, "ksud", "retry installed daemon")?;
+        let metadata = installed_daemon
+            .metadata()
+            .context("failed to fstat retry installed daemon")?;
+        anyhow::ensure!(
+            metadata.file_type().is_file()
+                && metadata.uid() == 0
+                && metadata.gid() == 0
+                && metadata.mode() & 0o777 == 0o755
+                && metadata.nlink() == 1
+                && metadata.len() > 0
+                && metadata.len() <= 64 * 1024 * 1024,
+            "retry /data/adb/ksud is not exact root:root 0755 nlink=1"
+        );
+
+        // The retry command must execute the same inode it authenticates and
+        // later commits into the completion receipt. This prevents a staged or
+        // replaced binary from authorizing a different installed ksud.
