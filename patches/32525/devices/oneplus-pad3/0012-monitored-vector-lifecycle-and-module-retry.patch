+fn append_module_lifecycle_log(message: &str) {
+    let operation = (|| -> Result<()> {
+        let name = public_log_name(MODULE_LIFECYCLE_LOG, "module lifecycle log")?;
+        let directory = open_cleanup_directory("/data/local/tmp", false)?;
+        let mut file = OpenOptions::new()
+            .append(true)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+            .open(MODULE_LIFECYCLE_LOG)
+            .context("failed to open authenticated module lifecycle log")?;
+        let metadata = file
+            .metadata()
+            .context("failed to fstat module lifecycle log")?;
+        anyhow::ensure!(
+            metadata.file_type().is_file()
+                && metadata.uid() == 0
+                && metadata.gid() == 0
+                && metadata.mode() & 0o777 == 0o644
+                && metadata.nlink() == 1,
+            "module lifecycle log metadata is not exact"
+        );
+        let path_metadata = fstatat_raw(&directory, &name, "module lifecycle log pathname")?;
+        anyhow::ensure!(
+            path_metadata.st_dev as u64 == metadata.dev()
+                && path_metadata.st_ino as u64 == metadata.ino(),
+            "module lifecycle log pathname no longer names the opened inode"
+        );
+        writeln!(file, "{message}").context("failed to append module lifecycle log")
+    })();
+    if let Err(error) = operation {
+        warn!("OnePlus Pad 3 late-load: failed to write module lifecycle log: {error:#}");
+    }
+}
