+            File::open("/proc/self/exe").context("failed to pin current retry executable")?;
+        let executable_metadata = current_executable
+            .metadata()
+            .context("failed to fstat current retry executable")?;
+        anyhow::ensure!(
+            executable_metadata.dev() == metadata.dev()
+                && executable_metadata.ino() == metadata.ino()
+                && executable_metadata.len() == metadata.len(),
+            "module-retry is not executing the installed /data/adb/ksud inode"
+        );
+
+        let sha256 = digest_exact_file(
+            &mut installed_daemon,
+            metadata.len(),
+            "retry installed daemon",
+        )?;
+        anyhow::ensure!(
+            sha256 == expected_sha256,
+            "installed retry ksud SHA-256 does not match the app request pin"
+        );
+
+        Ok(Self {
+            installed_parent,
+            installed_daemon,
+            device: metadata.dev(),
+            inode: metadata.ino(),
+            size: metadata.len(),
+            sha256,
+        })
+    }
+
+    fn verify(&mut self) -> Result<()> {
+        validate_root_data_directory(&self.installed_parent, "retry daemon parent")?;
+        let retained = self
+            .installed_daemon
+            .metadata()
+            .context("failed to fstat retained retry daemon")?;
+        anyhow::ensure!(
+            retained.file_type().is_file()
+                && retained.uid() == 0
+                && retained.gid() == 0
+                && retained.mode() & 0o777 == 0o755
+                && retained.nlink() == 1
+                && retained.dev() == self.device
+                && retained.ino() == self.inode
+                && retained.len() == self.size,
