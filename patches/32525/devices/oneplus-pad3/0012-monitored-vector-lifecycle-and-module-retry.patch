+fn process_has_known_vector_credentials(proc_path: &Path) -> bool {
+    let Ok(status) = fs::read_to_string(proc_path.join("status")) else {
+        return false;
+    };
+    let credentials = |prefix: &str| {
+        status
+            .lines()
+            .find_map(|line| line.strip_prefix(prefix))
+            .map(|values| values.split_whitespace().collect::<Vec<_>>())
+    };
+    let Some(uids) = credentials("Uid:") else {
+        return false;
+    };
+    let Some(gids) = credentials("Gid:") else {
+        return false;
+    };
+    let known_uids =
+        uids.as_slice() == ["0", "0", "0", "0"] || uids.as_slice() == ["0", "1000", "0", "1000"];
+    let known_gids = gids.as_slice() == ["0", "0", "0", "0"];
+    known_uids && known_gids
+}
+
+fn process_is_authenticated_vector_daemon(
+    proc_path: &Path,
+    vector_directory: &fs::Metadata,
+) -> bool {
+    if !process_has_known_vector_credentials(proc_path) {
+        return false;
+    }
+    let Ok(cwd) = fs::metadata(proc_path.join("cwd")) else {
+        return false;
+    };
+    if cwd.dev() != vector_directory.dev() || cwd.ino() != vector_directory.ino() {
+        return false;
+    }
+
+    let exact_comm = fs::read(proc_path.join("comm")).is_ok_and(|comm| comm == b"vectord\n");
+    let exact_argv = fs::read(proc_path.join("cmdline")).is_ok_and(|cmdline| {
+        cmdline.split(|byte| *byte == 0).any(|argument| {
+            argument == b"/data/adb/modules/zygisk_vector/daemon"
+                || argument == b"org.matrix.vector.daemon.VectorDaemon"
+        })
+    });
+    let daemon_apk = format!("{VECTOR_DIR}/daemon.apk");
+    let exact_map = fs::read_to_string(proc_path.join("maps")).is_ok_and(|maps| {
+        maps.lines()
+            .any(|line| line.split_whitespace().last() == Some(daemon_apk.as_str()))
+    });
+    exact_comm || exact_argv || exact_map
+}
