+/// Prefer a late-load-aware metamodule script and fall back to the normal
+/// post-fs-data script only when the primary script is absent.
+pub fn exec_stage_script_with_fallback(primary: &str, fallback: &str, block: bool) -> Result<()> {
+    let (stage, script_path) = if let Some(path) = check_metamodule_script(&format!("{primary}.sh"))
+    {
+        (primary, path)
+    } else if let Some(path) = check_metamodule_script(&format!("{fallback}.sh")) {
+        info!(
+            "late-load: metamodule has no {primary}.sh; using {fallback}.sh compatibility fallback"
+        );
+        (fallback, path)
+    } else {
+        return Ok(());
+    };
+
+    info!("Executing metamodule {stage}.sh");
+    crate::module::exec_script(&script_path, block)?;
+    info!("Metamodule {stage}.sh executed successfully");
+    Ok(())
+}
