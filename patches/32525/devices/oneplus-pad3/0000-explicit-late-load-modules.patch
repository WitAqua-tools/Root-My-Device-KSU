+/// Execute a late-load stage without running the same module twice.
+///
+/// A module that explicitly implements `primary` owns its late-load behavior.
+/// Legacy modules that only know the normal boot flow may instead provide
+/// `fallback`; those get that script once. The metamodule is handled by its
+/// own companion helper and is skipped here exactly as in exec_stage_script.
+pub fn exec_stage_script_with_fallback(primary: &str, fallback: &str, block: bool) -> Result<()> {
+    let metamodule_dir = metamodule::get_metamodule_path().and_then(|path| canonicalize(path).ok());
+
+    foreach_active_module(|module| {
+        if metamodule_dir.as_ref().is_some_and(|meta_dir| {
+            canonicalize(module).is_ok_and(|resolved| resolved == *meta_dir)
+        }) {
+            return Ok(());
+        }
+
+        let primary_path = module.join(format!("{primary}.sh"));
+        let fallback_path = module.join(format!("{fallback}.sh"));
+        let script_path = if primary_path.exists() {
+            primary_path
+        } else if fallback_path.exists() {
+            info!(
+                "late-load: {} has no {primary}.sh; using {fallback}.sh compatibility fallback",
+                module.display()
+            );
+            fallback_path
+        } else {
+            return Ok(());
+        };
+
+        exec_script(&script_path, block)
+    })?;
+
+    Ok(())
+}
