+/// Run the module stage used by the explicit late-load compatibility mode.
+///
+/// General scripts deliberately stay on `late-load.d`: silently replaying the
+/// machine-wide `post-fs-data.d` directory after Android has booted is too
+/// broad. For the metamodule and each enabled module, `late-load.sh` is
+/// preferred and `post-fs-data.sh` is used only when no late-load-specific
+/// script exists. This preserves the normal pre-mount ordering without double
+/// starting modules that already know how to late-load.
+pub fn run_late_load_compat_stage() {
+    utils::umask(0);
+
+    if utils::has_magisk() {
+        warn!("Magisk detected, skip late-load compatibility stage");
+        return;
+    }
+
+    if crate::utils::is_safe_mode() {
+        warn!("safe mode, skip late-load compatibility scripts");
+        return;
+    }
+
+    if let Err(e) = crate::module::exec_common_scripts("late-load.d", true) {
+        warn!("Failed to exec common late-load scripts: {e}");
+    }
+
+    if let Err(e) = metamodule::exec_stage_script_with_fallback("late-load", "post-fs-data", true) {
+        warn!("Failed to exec metamodule late-load compatibility script: {e}");
+    }
+
+    if let Err(e) =
+        crate::module::exec_stage_script_with_fallback("late-load", "post-fs-data", true)
+    {
+        warn!("Failed to exec module late-load compatibility scripts: {e}");
+    }
+}
