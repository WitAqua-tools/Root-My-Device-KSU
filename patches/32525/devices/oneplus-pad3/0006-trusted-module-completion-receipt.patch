+        "version=1\nboot_id={boot_id}\nrun_id={run_id}\nksud_sha256={expected_daemon_sha256}\n"
+    );
+    let temporary_path =
+        Path::new(PRIVATE_LATE_LOAD_ROOT).join(format!(".modules-loaded.{helper_pid}.tmp"));
+    let receipt_path = Path::new(TRUSTED_MODULE_COMPLETION_RECEIPT);
+
+    let result = (|| -> Result<()> {
+        let mut temporary = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+            .open(&temporary_path)
+            .context("failed to create trusted module receipt temporary file")?;
+        temporary
+            .write_all(content.as_bytes())
+            .context("failed to write trusted module receipt")?;
+        temporary
+            .sync_all()
+            .context("failed to sync trusted module receipt")?;
+        validate_receipt_file(&temporary, 0o600, "trusted module receipt temporary file")?;
+        drop(temporary);
+
+        fs::rename(&temporary_path, receipt_path)
+            .context("failed to atomically publish trusted module receipt")?;
+        File::open(PRIVATE_LATE_LOAD_ROOT)
+            .and_then(|directory| directory.sync_all())
+            .context("failed to sync trusted module receipt directory")?;
+
+        let mut published = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+            .open(receipt_path)
+            .context("failed to reopen trusted module receipt")?;
+        validate_receipt_file(&published, 0o600, "trusted module receipt")?;
+        let mut published_content = String::new();
+        published
+            .read_to_string(&mut published_content)
+            .context("failed to reread trusted module receipt")?;
+        anyhow::ensure!(
+            published_content == content,
+            "trusted module receipt changed after atomic publish"
+        );
+        Ok(())
+    })();
+    if result.is_err() {
+        let _ = fs::remove_file(&temporary_path);
+    }
+    result?;
 
-    let temporary_path = format!("{MODULE_COMPLETION_MARKER}.tmp.{}", std::process::id());
