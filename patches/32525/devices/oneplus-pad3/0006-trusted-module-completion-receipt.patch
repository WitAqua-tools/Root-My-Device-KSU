+fn staged_helper_pid(staged_daemon: &Path) -> Result<String> {
+    let helper_pid = staged_daemon
+        .parent()
+        .and_then(Path::file_name)
+        .and_then(|value| value.to_str())
+        .context("trusted staged daemon has no UTF-8 helper pid")?;
+    anyhow::ensure!(
+        !helper_pid.is_empty() && helper_pid.bytes().all(|byte| byte.is_ascii_digit()),
+        "trusted staged-daemon helper pid is not decimal"
+    );
+    Ok(helper_pid.to_owned())
+}
+
+fn completion_run_id() -> Result<String> {
+    let run_id = std::env::var(COMPLETION_RUN_ID_ENV)
+        .context("client completion run id was not supplied by the late-load helper")?;
+    anyhow::ensure!(
+        run_id.len() == 32
+            && run_id
+                .bytes()
+                .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte)),
+        "client completion run id is not 32 lowercase hex characters"
+    );
+    Ok(run_id)
+}
+
+fn validate_receipt_file(file: &File, expected_mode: u32, label: &str) -> Result<()> {
+    let metadata = file
+        .metadata()
+        .with_context(|| format!("failed to fstat {label}"))?;
+    anyhow::ensure!(metadata.file_type().is_file(), "{label} is not regular");
+    anyhow::ensure!(
+        metadata.uid() == 0 && metadata.gid() == 0,
+        "{label} is not root:root"
+    );
+    anyhow::ensure!(metadata.nlink() == 1, "{label} link count is not one");
+    anyhow::ensure!(
+        metadata.mode() & 0o777 == expected_mode,
+        "{label} mode is not {expected_mode:o}"
+    );
+    Ok(())
+}
+
+fn validate_private_receipt_directory() -> Result<()> {
+    let metadata = fs::symlink_metadata(PRIVATE_LATE_LOAD_ROOT)
+        .context("failed to inspect root-private receipt directory")?;
+    anyhow::ensure!(
+        metadata.file_type().is_dir(),
+        "root-private receipt parent is not a real directory"
+    );
+    anyhow::ensure!(
+        metadata.uid() == 0 && metadata.gid() == 0,
+        "root-private receipt parent is not root:root"
+    );
+    anyhow::ensure!(
+        metadata.mode() & 0o777 == 0o700,
+        "root-private receipt parent is not mode 0700"
+    );
+    Ok(())
+}
