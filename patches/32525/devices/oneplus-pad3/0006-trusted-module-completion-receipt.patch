+fn write_trusted_module_receipt(staged_daemon: &Path, expected_daemon_sha256: &str) -> Result<()> {
+    validate_private_receipt_directory()?;
+    let enforcing = fs::read(SELINUX_ENFORCE_PATH)
+        .context("failed to read SELinux enforcing state before completion receipt")?;
+    anyhow::ensure!(
