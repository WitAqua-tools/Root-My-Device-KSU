+/// Execute one stage script and require a successful exit before its bounded
+/// deadline. This is used only by late-load completion receipts; normal boot
+/// service stages retain their asynchronous behavior.
+pub fn exec_script_until<T: AsRef<Path>>(
+    path: T,
+    stage_deadline: std::time::Instant,
+) -> Result<()> {
+    let path = path.as_ref();
+    let remaining = stage_deadline.saturating_duration_since(std::time::Instant::now());
+    ensure!(
+        !remaining.is_zero(),
+        "Stage deadline elapsed before dispatching {}",
+        path.display()
+    );
+    info!(
+        "exec and verify {} (stage deadline remaining={}ms)",
+        path.display(),
+        remaining.as_millis()
+    );
+
+    let mut child = build_script_command(path)
+        .spawn()
+        .map_err(|e| anyhow!("Failed to exec {}: {e}", path.display()))?;
+    loop {
+        if let Some(status) = child
+            .try_wait()
+            .with_context(|| format!("Failed to wait for {}", path.display()))?
+        {
+            ensure!(
+                status.success(),
+                "Script {} exited with {status}",
+                path.display()
+            );
+            return Ok(());
+        }
+
+        if std::time::Instant::now() >= stage_deadline {
+            let pid = child.id();
+            if let Err(error) = child.kill() {
+                warn!(
+                    "Failed to kill timed-out script {} pid={pid}: {error}",
+                    path.display()
+                );
+            }
+            let _ = child.wait();
+            bail!(
+                "Script {} reached the shared stage deadline (pid={pid})",
+                path.display(),
+            );
+        }
+        std::thread::sleep(std::time::Duration::from_millis(100));
+    }
 }
 
