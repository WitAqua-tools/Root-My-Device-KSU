+/// Dispatch a late-load completion stage and wait for every script receipt.
+/// Vector's long-lived daemon is launched by its dedicated adapter and can be
+/// excluded here; every script that remains must exit zero before its timeout.
+pub fn run_stage_to_completion(
+    stage: &str,
+    excluded_module: Option<&str>,
+    stage_timeout: std::time::Duration,
+) -> Result<()> {
+    utils::umask(0);
+
+    anyhow::ensure!(
+        !utils::has_magisk(),
+        "Magisk detected, refusing completion-checked {stage} stage"
+    );
+    anyhow::ensure!(
+        !crate::utils::is_safe_mode(),
+        "safe mode active, refusing completion-checked {stage} stage"
+    );
+    anyhow::ensure!(!stage_timeout.is_zero(), "{stage} stage timeout is zero");
+    let stage_deadline = std::time::Instant::now()
+        .checked_add(stage_timeout)
+        .context("stage deadline overflow")?;
+
+    crate::module::exec_common_scripts_until(&format!("{stage}.d"), stage_deadline)
+        .with_context(|| format!("common {stage} scripts did not complete"))?;
+    metamodule::exec_stage_script_until(stage, stage_deadline)
+        .with_context(|| format!("metamodule {stage} script did not complete"))?;
+    crate::module::exec_stage_script_except_until(stage, excluded_module, stage_deadline)
+        .with_context(|| format!("module {stage} scripts did not complete"))?;
+    Ok(())
+}
